from .constants import constant as constant
from .field import Field as Field
from .proto import Proto as Proto
from .wb import wb as wb
from _typeshed import Incomplete

class ContactPoint:
    point: Incomplete
    node_id: Incomplete
    def __init__(self, point) -> None: ...
    def getPoint(self): ...
    def getNodeId(self): ...

class Node: ...

class Node:
    def __init__(self, DEF: str | None = None, tag: int | None = None, id: int | None = None, selected: bool | None = None, ref: int | None = None) -> None: ...
    def getDef(self) -> str: ...
    def getId(self) -> int: ...
    def getParentNode(self) -> Node: ...
    def isProto(self) -> bool: ...
    def getProto(self) -> Proto: ...
    def getFromProtoDef(self, DEF: str) -> Node: ...
    def getType(self) -> int: ...
    def getTypeName(self) -> str: ...
    def getBaseTypeName(self) -> str: ...
    def remove(self) -> None: ...
    def exportString(self): ...
    def getField(self, fieldName: str) -> Field: ...
    def getFieldByIndex(self, index: int) -> Field: ...
    def getNumberOfFields(self) -> int: ...
    def getBaseNodeField(self, fieldName: str) -> Field: ...
    def getBaseNodeFieldByIndex(self, index: int) -> Field: ...
    def getNumberOfBaseNodeFields(self) -> int: ...
    def getPosition(self) -> list[float]: ...
    def getOrientation(self) -> list[float]: ...
    def getPose(self, fromNode: Node = None) -> list[float]: ...
    def enablePoseTracking(self, samplingPeriod: int, fromNode: Node = None): ...
    def disablePoseTracking(self, fromNode: Node = None): ...
    def getCenterOfMass(self) -> list[float]: ...
    def getContactPoints(self, includeDescendants: bool = False) -> list[ContactPoint]: ...
    def enableContactPointsTracking(self, samplingPeriod: int, includeDescendants: bool = False): ...
    def disableContactPointsTracking(self, includeDescendants: bool = False): ...
    def getStaticBalance(self) -> bool: ...
    def getVelocity(self) -> list[float]: ...
    def setVelocity(self, velocity: list[float]): ...
    def saveState(self, stateName: str): ...
    def loadState(self, stateName: str): ...
    def resetPhysics(self) -> None: ...
    def setJointPosition(self, position: float, index: int = 1): ...
    def restartController(self) -> None: ...
    def moveViewpoint(self) -> None: ...
    def setVisibility(self, fromNode: Node, visible: bool): ...
    def addForce(self, force: list[float], relative: bool): ...
    def addForceWithOffset(self, force: list[float], offset: list[float], relative: bool): ...
    def addTorque(self, torque: list[float], relative: bool): ...
    @property
    def DEF(self) -> str: ...
    @property
    def id(self) -> int: ...
    @property
    def type(self) -> int: ...
    @property
    def type_name(self) -> str: ...
    @property
    def base_type_name(self) -> str: ...
    @property
    def number_of_fields(self) -> int: ...
    @property
    def number_of_base_node_fields(self) -> int: ...

def getSFNode(self) -> Node: ...
def getMFNode(self, index: int) -> Node: ...
