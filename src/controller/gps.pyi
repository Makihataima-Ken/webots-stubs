from .sensor import Sensor as Sensor
from .wb import wb as wb

class GPS(Sensor):
    LOCAL: int
    WGS84: int
    def __init__(self, name: str | int, sampling_period: int = None) -> None: ...
    def getCoordinateSystem(self) -> int: ...
    @property
    def coordinate_system(self) -> int: ...
    @staticmethod
    def convertToDegreesMinutesSeconds(decimalDegrees) -> str: ...
    def getSpeed(self) -> float: ...
    @property
    def speed(self) -> float: ...
    def getSpeedVector(self) -> list[float]: ...
    @property
    def speed_vector(self) -> list[float]: ...
    def getValues(self) -> list[float]: ...
    @property
    def value(self) -> list[float]: ...
