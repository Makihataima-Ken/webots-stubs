from .device import Device as Device
from .wb import wb as wb

class Emitter(Device):
    CHANNEL_BROADCAST: int
    def __init__(self, name: str | int) -> None: ...
    def getBufferSize(self) -> int: ...
    @property
    def buffer_size(self) -> int: ...
    def send(self, message: str | bytes | list[float], length: int | None = None): ...
    def getChannel(self) -> int: ...
    def setChannel(self, channel: int): ...
    @property
    def channel(self) -> int: ...
    @channel.setter
    def channel(self, c: int): ...
    def getRange(self) -> float: ...
    def setRange(self, range: float): ...
    @property
    def range(self) -> float: ...
    @range.setter
    def range(self, range: float): ...
