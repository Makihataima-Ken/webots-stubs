from .wb import wb as wb
from _typeshed import Incomplete

class MouseState:
    u: Incomplete
    v: Incomplete
    x: Incomplete
    y: Incomplete
    z: Incomplete
    left: Incomplete
    middle: Incomplete
    right: Incomplete
    def __init__(self, u: float, v: float, x: float, y: float, z: float, left: bool, middle: bool, right: bool) -> None: ...

class Mouse:
    def __init__(self, sampling_period: int | None = None) -> None: ...
    def enable(self, p: int): ...
    def disable(self) -> None: ...
    def getSamplingPeriod(self) -> int: ...
    def getState(self) -> MouseState: ...
    def enable3dPosition(self) -> None: ...
    def disable3dPosition(self) -> None: ...
    def is3dPositionEnabled(self) -> bool: ...
    @property
    def sampling_period(self) -> int: ...
    @sampling_period.setter
    def sampling_period(self, p: int | None): ...
