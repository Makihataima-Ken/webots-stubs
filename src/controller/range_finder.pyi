from .sensor import Sensor as Sensor
from .wb import wb as wb

class RangeFinder(Sensor):
    def __init__(self, name: str | int, sampling_period: int = None) -> None: ...
    def getFov(self) -> float: ...
    def getWidth(self) -> int: ...
    def getHeight(self) -> int: ...
    def getMaxRange(self) -> float: ...
    def getMinRange(self) -> float: ...
    def getRangeImage(self, data_type: str = 'list') -> list[float]: ...
    def getRangeImageArray(self) -> list[list[float]]: ...
    @staticmethod
    def rangeImageGetDepth(image, width, x, y) -> float: ...
    def saveImage(self, filename: str, quality: int) -> int: ...
    @property
    def range_image(self): ...
    @property
    def fov(self) -> float: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def max_range(self) -> float: ...
    @property
    def min_range(self) -> float: ...
